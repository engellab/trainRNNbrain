#!/bin/bash
# PENALTIES x TASK COMPLEXITY x SIZE on the n-bit flip-flop (SPOCK)
#
# Two questions, one grid.
#
# 1. DOES THE PENALTY REDUCE CROSS-CHANNEL INTERFERENCE? The unpenalised floor obeys
#        floor_per_channel(k) = a + b*sqrt(k)      a = 0.0208, b = 0.0029
#    exactly - residuals at the seed-noise level over k=1..8, and confirmed out of sample at k=1,
#    which neither candidate model had seen. C(k,2) is rejected at dAICc +70.7. That makes this a
#    SHARP test with three distinguishable outcomes rather than a vague "is it better":
#        b falls, a unchanged   -> the penalty reduces INTERFERENCE. A performance argument for
#                                  activity regularisation on multi-component tasks.
#        a falls, b unchanged   -> better single-channel tracking. Real, but NOT an interference
#                                  story and must not be told as one.
#        neither moves          -> hypothesis dead; the CDDM N=5000 advantage is something else.
#    Pre-registered in docs/experiments/penalty_vs_interference.md, falsifier fixed in advance.
#
# 2. DOES THE PENALTY CHANGE THE M(N) EXPONENT? Unpenalised, active units grow as M ~ N^0.37 on the
#    flip-flop and N^0.31-0.35 on CDDM - both sublinear, so enlarging the network does not buy
#    proportionally more active units. frm drives the silent fraction to ~0 by construction, so the
#    interesting question is what happens to the SCALING, which needs all three sizes.
#
# Grid = 3 sizes x 8 complexities x 3 penalties x 3 seeds = 216 jobs.
#   N   in {500, 1000, 2000}
#   k   in {1..8}          swept via task.n_inputs = task.n_outputs
#   pen in {rws, frm, both}
# Index decode (TID = SLURM_ARRAY_TASK_ID-1, 0..215):
#   REP=TID%3;  N_IDX=(TID/3)%3;  K_IDX=(TID/9)%8;  P_IDX=TID/72
#
# WHY 150000 ITERATIONS, WHICH IS LESS THAN THE UNPENALISED SWEEP'S 400-500k.
# Budgets need only be SUFFICIENT, not matched, for any quantity that converges - and the floor does.
# Measured on the CDDM penalty runs, the clean task loss reaches within 2% of its final value at
# 4.6k-14.6k (rws, frm) and 12.8k-38.6k (both, rising with N). Penalties do not slow convergence;
# frm is faster than unpenalised. 150k is ~4x the slowest case observed.
#   ⚠️ The one quantity that does NOT converge is the silent fraction - still +5 pp per doubling at
#   490k. So every silent-fraction or active-unit comparison against the unpenalised grid must read
#   BOTH sides at 150k, by reading the existing 400-500k traces backward. penalty_matched.py already
#   does exactly this. Quoting a 150k penalised number against a 500k unpenalised one is invalid.
#
# ⚠️ LAMBDA IS TUNED FOR CDDM, whose task loss is ~0.007 against the flip-flop's ~0.025, so the
# penalty binds relatively WEAKLY here. Check the silent fraction FIRST: if frm does not drive it to
# ~0, that is a mis-scaled lambda and says nothing about interference. Re-tune and re-check the
# convergence time before interpreting any floor result, since a stronger lambda may also slow
# convergence past 150k.
#
# Adam's moment estimates are now saved alongside the parameters (run_experiment.py), so any cell
# that turns out to need longer can be warm-started rather than restarted. The load path is not
# written yet - this only preserves the option.
#
# Submit ONE ARRAY PER SIZE so the wall-time request matches the cell (measured at batch 1024, fresh
# batches: 0.24 s/iter at N=500, ~0.26 at N=1000, 0.55 at N=2000):
#   N=500  -> 150k x 0.24 = 10.0 h   request 24 h
#   N=1000 -> 150k x 0.26 = 10.8 h   request 24 h
#   N=2000 -> 150k x 0.55 = 22.9 h   request 48 h  (31 h on a 1.35x slow node)
# The task lists are generated by the submit loop at the bottom of this header, not by hand.
#
# Output: $SAVE_TO/NBitFlipFlop_std_pen/EqType=h_k=<k>_N=<N>_pen=<name>/<per-net subfolder>

#SBATCH --job-name=FFpen
#SBATCH --partition=all
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --array=1-216
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=pt1290@princeton.edu
#SBATCH --output=/usr/people/pt1290/trainRNNbrain_logs/%x.%A_%a.out
#SBATCH --error=/usr/people/pt1290/trainRNNbrain_logs/%x.%A_%a.err

module purge
module load anacondapy/2024.02
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate torch-env

set -eo pipefail
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

REPO="${REPO:-$HOME/trainRNNbrain}"
SAVE_TO="${SAVE_TO:-$HOME/trainRNNbrain/data/trained_RNNs}"

export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"
PKG=$(python -c "import trainRNNbrain, os; print(os.path.realpath(os.path.dirname(os.path.dirname(trainRNNbrain.__file__))))")
REPO_REAL=$(readlink -f "$REPO")
if [ "$PKG" != "$REPO_REAL" ]; then
  echo "FATAL: trainRNNbrain resolves to $PKG, expected $REPO_REAL (from $REPO) — aborting." >&2; exit 1
fi
echo "code: $PKG @ $(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo UNKNOWN)"
if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
  echo "WARNING: $REPO has uncommitted changes; the commit above does not fully describe this run." >&2
fi

KS=(1 2 3 4 5 6 7 8)
NS=(500 1000 2000)
PEN_NAME=(rws frm both)
PEN_RWS=(0.05 0 0.05)
PEN_FRM=(0 0.1 0.1)
IT=150000

TID=$((SLURM_ARRAY_TASK_ID - 1))
REP=$((TID % 3)); N_IDX=$(((TID / 3) % 3)); K_IDX=$(((TID / 9) % 8)); P_IDX=$((TID / 72))
K=${KS[$K_IDX]}; N=${NS[$N_IDX]}
PNAME=${PEN_NAME[$P_IDX]}; LRWS=${PEN_RWS[$P_IDX]}; LFRM=${PEN_FRM[$P_IDX]}
IT=${ITERS_OVERRIDE:-$IT}

TAG="std_pen/EqType=h_k=${K}_N=${N}_pen=${PNAME}"
mkdir -p "${SAVE_TO}/NBitFlipFlop_std_pen"
echo "Task ${SLURM_ARRAY_TASK_ID}: k=${K} N=${N} pen=${PNAME} (rws=${LRWS} frm=${LFRM}) rep=${REP} iters=${IT}"
echo "  -> ${SAVE_TO}/NBitFlipFlop_${TAG}"

srun python "$REPO/trainRNNbrain/training/run_experiment.py" \
  seed="random" \
  +experiment=silent_units_largeN \
  task=NBitFlipFlop \
  task.n_inputs="$K" task.n_outputs="$K" \
  model=rnn_relu_standard trainer=trainer_ptrack_freshbatch \
  model.equation_type=h model.N="$N" \
  trainer.max_iter="$IT" \
  trainer.track_drift=true trainer.track_every=10 trainer.store_participation_every=100 \
  trainer.track_valid=false \
  trainer.lambda_rws="$LRWS" trainer.lambda_frm="$LFRM" \
  paths.save_to="$SAVE_TO" \
  experiment_tag="\"${TAG}\""
